{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "back": "cd ../backend && mvn spring-boot:run -Dspring-boot.run.profiles=supabase",
    "dev:all": "concurrently --kill-others --names BACK,FRONT --prefix-colors yellow,magenta \"npm run back\" \"npm run dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tokens": "node scripts/generate-tokens.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests playwright.config.js index.html"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "vite": "^8.3.5"
  }
}
