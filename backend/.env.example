# Arquivo no formato Java properties, sem aspas. Copie para backend/.env.
# Use Connect > Session pooler (5432) se sua rede não tiver IPv6.
# Copie o host do painel; não é possível deduzir o host do pooler pela região.
SUPABASE_DB_URL=jdbc:postgresql://db.obohphyddhvddpqwrapx.supabase.co:5432/postgres?sslmode=require&connectTimeout=10
SUPABASE_DB_USERNAME=allocar_api
SUPABASE_DB_PASSWORD=

# O perfil supabase habilita a conexão JDBC do backend.
# SPRING_PROFILES_ACTIVE=supabase
SUPABASE_DB_POOL_SIZE=5

# Origens do frontend, separadas por vírgula. Em HTTPS, ative o cookie Secure.
ALLOCAR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOCAR_COOKIE_SECURE=false
